@{
    ViewData["Title"] = "Auto Scheduling";
}

<div class="container">

    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Schedules" asp-action="Index"><i class="fas fa-calendar-alt"></i> Schedules</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Auto Scheduling
            </li>
        </ol>
    </nav>

    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header">
                        <h4 class="card-title mb-0">Auto Scheduling</h4>
                    </div>
                    <div class="card-body">

                        <table class="table table-bordered align-middle mt-3">
                            <tbody>
                                <tr>
                                    <th scope="row" class="w-25">Unscheduled Bins</th>
                                    <td>@ViewBag.BinCount</td>
                                </tr>
                                <tr>
                                    <th scope="row">Available Trucks</th>
                                    <td>@ViewBag.TruckCount</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="d-flex justify-content-between align-items-center">
                            @if (ViewBag.CanSchedule)
                            {
                                <form asp-action="AutoScheduleConfirmed" method="post" class="mt-4">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="fas fa-arrow"></i> Proceed
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-warning mt-4 d-flex align-items-center" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Not enough bins or trucks available to perform scheduling.
                                </div>
                            }

                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Back
                            </a>
                        </div>
                        

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
