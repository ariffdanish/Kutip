@model List<Kutip.Models.Schedule>
@{
    Layout = null;
    var isPreview = ViewBag.IsPreview != null && (bool)ViewBag.IsPreview;
    var startDate = ViewBag.StartDate;
    var endDate = ViewBag.EndDate;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Pickup Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="text-center mb-4">
            <img src="~/assets/img/light2_kutipLogo.png" alt="Logo" style="height: 80px;" />
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Pickup Report</h2>
            @if (isPreview)
            {
                var exportUrl = Url.Action("ExportPickupReport", "Dashboard", new
                {
                    startDate = startDate,
                    endDate = endDate,
                    streetFilter = ViewBag.SelectedStreet
                });
                <a href="@exportUrl" target="_blank" class="text-decoration-none text-dark" title="Download PDF">
                    <i class="bi bi-download fs-4"></i>
                </a>
            }
        </div>
        @if (isPreview)
        {
            <form method="get" asp-action="PickupReportPreview" asp-controller="Dashboard" class="row mb-3">
                <input type="hidden" name="preview" value="true" />

                <div class="col-md-3">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>

                <div class="col-md-3">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>

                <div class="col-md-3">
                    <label for="streetFilter" class="form-label">Search Street</label>
                    <input type="text"
                           id="streetFilter"
                           name="streetFilter"
                           class="form-control"
                           placeholder="e.g. Main St"
                           value="@ViewBag.SelectedStreet" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Pickup Time</th>
                        <th>Truck</th>
                        <th>Driver Name</th>
                        <th>Driver Phone</th>
                        <th>Bin</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Issues</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.UpdatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@e.UpdatedAt.ToString("HH:mm")</td>
                            <td>@(e.Truck?.TruckNo ?? "-")</td>
                            <td>@(e.Truck?.DriverName ?? "-")</td>
                            <td>@(e.Truck?.Phone ?? "-")</td>
                            <td>@(e.Bin?.BinNo ?? "-")</td>
                            <td>
                                @(e.Bin != null
                                                            ? $"{e.Bin.Street}, {e.Bin.PostCode}, {e.Bin.City}, {e.Bin.State}"
                                                            : "-")
                        </td>
                        <td>
                            @if (e.Status == ScheduleStatus.Completed)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (e.Status == ScheduleStatus.Missed)
                                {
                                    <span class="badge bg-danger">Missed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                        </td>
                        <td>@(e.Issues ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Auto-submit when date or street input changes
            $('#streetFilter').on('input', function () {
                $(this).closest('form').submit();
            });

            // Optional: Submit on date change too
            $('input[type="date"]').on('change', function () {
                $(this).closest('form').submit();
            });
        });
    </script>
}
