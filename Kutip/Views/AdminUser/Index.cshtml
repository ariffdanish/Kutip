@model IEnumerable<(Kutip.Models.ApplicationUser user, IList<string> roles)>

@{
    ViewData["Title"] = "User Management";
}

<div class="container">

    <nav aria-label="breadcrumb" class="my-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Dashboard")"><i class="fas fa-home"></i> Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-users-cog"></i> User Management
            </li>
        </ol>
    </nav>

    <div class="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">User Management</h4>
                        <a asp-controller="AdminUser" asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="fas fa-user-plus"></i> Add User
                        </a>
                    </div>

                    <div class="card-body">
                        <div class="row g-4">
                            @foreach (var entry in Model)
                            {
                                <div class="col-12 col-md-6 col-lg-4 d-flex">
                                    <div class="card shadow flex-fill">
                                        <div class="card-body d-flex flex-column justify-content-between">
                                            <div>
                                                <h5 class="card-title text-center">@entry.user.FirstName @entry.user.LastName</h5>
                                                <h6 class="card-subtitle mb-2 text-muted text-center">Roles:</h6>
                                                <div class="mb-3 text-center">
                                                    @foreach (var role in entry.roles)
                                                    {
                                                        <span class="badge bg-secondary me-1">@role</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 mt-auto">
                                                <a asp-controller="AdminUser" asp-action="Edit" asp-route-id="@entry.user.Id"
                                                   class="btn btn-warning btn-sm w-100" title="Edit">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <form asp-controller="AdminUser" asp-action="Delete" asp-route-id="@entry.user.Id"
                                                      method="post" class="w-100" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                    <button type="submit" class="btn btn-danger btn-sm w-100" title="Delete">
                                                        <i class="fas fa-trash-alt"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
